{
  "name": "vba",
  "displayName": "CJ's VSCode VBA",
  "description": "VBA language syntax highlighting support and code snippets for VSCode",
  "version": "1.1.6",
  "icon": "images/VBALogo.jpg",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jaunito76/vscode-vba"
  },
  "activationEvents": [
    "onLanguage:vba"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vba",
        "aliases": [
          "VBA",
          "vba"
        ],
        "extensions": [
          ".bas",
          ".cls",
          ".frm",
          ".sht",
          ".wbk"
        ],
        "configuration": "./vba.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vba",
        "scopeName": "source.vba",
        "path": "./syntaxes/vba.json"
      }
    ],
    "snippets": [
      {
        "language": "vba",
        "path": "./snippets/vba.json"
      }
    ]
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint client/src server/src --ext ts",
    "test:unit": "npm run test:unit --workspace=server",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit && vscode-test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
