{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["{", "}"], 
    ["[", "]"], 
    ["(", ")"],
    ["\"","\""]
  ],
    "autoClosingPairs": [
        {"open": "(", "close": ")"},
        {"open": "[", "close": "]"},
        {"open": "\"", "close": "\""}
    ],
    "surroundingPairs": [
        {"open": "(", "close": ")"},
        {"open": "[", "close": "]"},
        {"open": "\"", "close": "\""}
    ],
  "folding": {
        "markers": {
            "start": "^\\s*(Public|Private|Friend)?\\s*(Static)?\\s*(Sub|Function|Property)\\s+",
            "end": "^\\s*End\\s+(Sub|Function|Property)"
        }
    }
}
