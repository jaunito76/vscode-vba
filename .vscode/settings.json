// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "client/out": false, // set this to true to hide the "out" folder with the compiled JS files
        "server/out": false
    },
    "search.exclude": {
        "client/out": true, // set this to false to include "out" folders in search results
        "server/out": true
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off"
}